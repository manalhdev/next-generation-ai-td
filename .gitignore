# Keep secrets and local files out of a public repository.
# Keys live in environment variables (see guide-environnement-etudiant-en.md).
# Copy this file to the root of your repository if that root is not kit-td1.
.env
.env.*
*.env
.envrc
*.key
*.pem
secrets*
credentials*
ready-for-td1.txt

# Virtual environments and Python caches
.venv/
venv/
__pycache__/
*.pyc

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local download / extraction folders
_download/
*.zip

# Draft reference values: regenerate locally with prep/draft_references.py (not published)
prep/draft-reference-td1.csv

# Template of the environment file is versioned, the real one never is
!.env.example

# Local AI-assistant configuration
CLAUDE.md
AGENTS.md
.claude/
